
@model EducaPlus.ViewModels.LancamentoNotasViewModel

@{
    ViewData["Title"] = "Lançamento de Notas";
}

<h2>Lançamento de Notas</h2>
<h5>@Model.DescricaoAvaliacao</h5>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">
        @TempData["Sucesso"]
    </div>
}

<form asp-action="Lancamento" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="IdAvaliacao" />

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Aluno</th>
                <th>Nota (0 a 10)</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < Model.Alunos.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Alunos[i].NomeCompleto

                        <input type="hidden"
                               asp-for="Alunos[i].IdAluno" />
                    </td>

                    <td>
                        <input asp-for="Alunos[i].ValorNota"
                               type="number"
                               min="0"
                               max="10"
                               step="0.01"
                               class="form-control"
                               style="max-width: 150px;" />

                        <span asp-validation-for="Alunos[i].ValorNota"
                              class="text-danger"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">
        Salvar notas
    </button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
